# Copy to .env. Never commit secrets.
# Default is local dummy path. Production send stays blocked until BINDING-DECISIONS.md is green
# AND APP_ENV=production AND DRY_RUN=false AND kill switches off AND a human authorizes that send.

APP_ENV=development
DRY_RUN=true
FIXTURE_MODE=true
KILL_SWITCH=0
KILL_OUTBOX=0
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
LOG_LEVEL=info
ARTIFACT_DIR=./artifacts

# Required for API persistence (MemoryStore if empty — local only, not VPS)
DATABASE_URL=postgres://newsletter:newsletter@127.0.0.1:5432/newsletter

# CSRF + archive signatures. Production boot refuses the compiled-in default.
APP_SECRET=replace-with-32-plus-bytes-of-entropy
WORKER_TOKEN=replace-with-worker-bearer-token

DUAL_CONTROL_FIRST_N=4

# Echo raw approval tokens back in the request body so `npm run approve:dummy`
# can drive the flow locally. Honoured ONLY when APP_ENV=development.
# Never enable this on a reachable host: it hands a valid approval token to
# anyone holding WORKER_TOKEN.
ALLOW_TOKEN_ECHO=0

# GHL — typed client names only. Leave empty for DRY_RUN stubs.
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=v3
GHL_SANDBOX_LOCATION_ID=
GHL_SANDBOX_USER_ID=
GHL_SANDBOX_PIT=
GHL_PROD_LOCATION_ID=
GHL_PROD_USER_ID=
GHL_PROD_PIT=

# Twenty projection (optional no-op if empty)
TWENTY_API_URL=
TWENTY_API_KEY=
TWENTY_NEWSLETTER_OBJECT=newsletterIssues

# LLM. Set LLM_PROVIDER=anthropic and supply a key to summarise with Claude.
# Missing key or LLM_PROVIDER=fixture -> deterministic offline summarizer.
# LLM_MODEL defaults to claude-haiku-4-5. Raise it to claude-sonnet-5 if the
# copy is not up to the brand bar; nothing else needs to change.
# A model failure never silently falls back to the offline summarizer — the
# issue goes to qa_failed and the approver is notified.
LLM_PROVIDER=fixture
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5

# Staff notify: JSON POST of issueKey + inert GET URL. Never a list send.
# Staff notification. Deliberately NOT LC Email: that is the subscriber
# channel, and operational mail on the marketing domain risks its reputation.
# Any transactional provider that speaks SMTP works (Postmark, SES, Resend...).
# All three of FROM/TO/SMTP_URL must be set, or email is treated as misconfigured.
STAFF_NOTIFY_FROM=
STAFF_NOTIFY_TO=
STAFF_NOTIFY_SMTP_URL=
STAFF_NOTIFY_WEBHOOK=
# Urgent escalations only (watchdog: overdue approval, dead-lettered outbox).
# Separate from STAFF_NOTIFY_WEBHOOK so a pager target can be configured
# without every routine notification waking someone.
ONCALL_WEBHOOK_URL=

# VPS / docker-compose.prod.yml (never commit real values)
POSTGRES_USER=newsletter
POSTGRES_PASSWORD=replace-with-unique-postgres-password
POSTGRES_DB=newsletter
# DOMAIN=newsletter.example.com

