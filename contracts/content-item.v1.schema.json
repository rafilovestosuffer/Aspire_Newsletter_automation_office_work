{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aspire.local/contracts/content-item.v1.json",
  "title": "ContentItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "sourceId",
    "canonicalUrl",
    "title",
    "excerpt",
    "publishedAt",
    "cveIds",
    "rawHash"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["post", "threat"] },
    "sourceId": { "type": "string", "minLength": 1 },
    "canonicalUrl": { "type": "string", "format": "uri" },
    "title": { "type": "string" },
    "excerpt": { "type": "string" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "cveIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" }
    },
    "rawHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "score": { "type": "number" },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "unknown"]
    },
    "vendorProduct": { "type": "string" },
    "knownRansomware": { "type": "boolean" }
  }
}
