# Optional nginx reverse proxy if Caddy is not used.
# TLS termination is expected in front of this server (or add ssl_certificate here).
# proxy_set_header X-Forwarded-* so Fastify trustProxy sees the public host.

upstream e02_api {
    server 127.0.0.1:8787;
}

server {
    listen 80;
    server_name _;

    location / {
        proxy_pass http://e02_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
