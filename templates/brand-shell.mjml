<mjml>
  <mj-head>
    <mj-title>{{subject}}</mj-title>
    <mj-preview>{{preheader}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="{{textColor}}" font-size="16px" line-height="1.5" />
      <mj-button background-color="{{primaryColor}}" color="#0B1220" font-weight="bold" border-radius="4px" />
    </mj-attributes>
    <mj-style>
      a { color: {{primaryColor}}; }
    </mj-style>
  </mj-head>
  <mj-body background-color="{{backgroundColor}}" width="600px">
    <mj-section padding="24px 16px 8px">
      <mj-column>
        <mj-text font-size="12px" color="#9AA8BC">{{displayName}} · {{issueLabel}}</mj-text>
        <mj-text font-size="22px" font-weight="bold" padding-top="0">{{displayName}} Weekly</mj-text>
        <mj-text font-size="14px"><a href="{{archiveUrl}}">View in browser</a></mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="8px 16px">
      <mj-column>
        <mj-text>{{editorBlurb}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="8px 16px 0">
      <mj-column>
        <mj-text font-size="18px" font-weight="bold">From the blog</mj-text>
      </mj-column>
    </mj-section>
    {{postBlocks}}

    <mj-section padding="16px 16px 0">
      <mj-column>
        <mj-text font-size="18px" font-weight="bold">This week in threats</mj-text>
        <mj-text font-size="12px" color="#9AA8BC">Public vulnerability intelligence. CISA KEV catalog data is CC0. This newsletter is not a CISA or DHS product and does not use agency marks.</mj-text>
      </mj-column>
    </mj-section>
    {{threatBlocks}}

    <mj-section padding="24px 16px 32px">
      <mj-column>
        <mj-divider border-color="#243044" />
        <mj-text font-size="12px" color="#9AA8BC">
          {{legalName}}<br/>
          {{postalAddress}}<br/>
          {{advertisementNotice}}<br/><br/>
          You received this because you opted in to the Weekly Newsletter category.<br/>
          <a href="{{unsubscribeUrl}}">Unsubscribe</a> · <a href="{{preferenceUrl}}">Preferences</a><br/>
          {{ghlUnsubscribeMergeTag}}<br/>
          <a href="{{archiveUrl}}">Archive</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
