<mjml>
  <mj-head>
    <mj-title>{{subject}}</mj-title>
    <mj-preview>{{preheader}}</mj-preview>
    <mj-attributes>
      <!-- Two web-safe faces, no webfont. Outlook on Windows will not load one,
           and the fallback is what most of a real list would see. -->
      <mj-all font-family="{{bodyFont}}" />
      <mj-text color="{{textColor}}" font-size="16px" line-height="1.6" />
      <mj-button background-color="{{primaryColor}}" color="#FFFFFF" font-weight="bold" border-radius="3px" />
      <mj-section background-color="{{backgroundColor}}" />
    </mj-attributes>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
    </mj-raw>
    <mj-style>
      /* Links as dark text with a coloured underline rather than coloured
         text: markedly better contrast against a light background, and it
         keeps the accent colour meaning "this is a link" instead of competing
         with the severity pills for attention. */
      a { color: inherit; text-decoration: underline; text-decoration-color: {{primaryColor}};
          text-underline-offset: 2px; text-decoration-thickness: 2px; }
      /* Severity and deadline pills are the one place colour carries meaning
         rather than decoration, so they keep their own fill in dark mode and
         only the surrounding surface flips. */
      .pill { border-radius: 3px; padding: 2px 7px; color: #ffffff; font-weight: bold; }
      /* Dark-mode support for clients that honour prefers-color-scheme
         (Apple Mail, many webmail/Android clients). Classic Outlook on
         Windows applies no dark transform at all and simply renders the
         light palette below as-is, which is the correct, safe fallback —
         see docs/plan for the research behind this choice. */
      @media (prefers-color-scheme: dark) {
        .dm-bg { background-color: #14181f !important; }
        .dm-card { background-color: #1c212b !important; }
        .dm-text { color: #eef1f5 !important; }
        .dm-muted { color: #9aa5b1 !important; }
        .dm-rule { border-color: #2c333f !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="{{backgroundColor}}" width="600px" css-class="dm-bg">
    <mj-section padding="28px 16px 0" css-class="dm-bg">
      <mj-column>
        {{logoBlock}}
        <!-- The masthead carries identity, not the headline. The subject is
             capped at 60 characters for the inbox envelope, so setting it as
             an H1 printed a headline truncated mid-phrase — and the reader
             has already seen the subject in their inbox. The lead story is
             stated in full, once, in the opening below. -->
        <mj-text font-size="11px" color="{{mutedColor}}" letter-spacing="1.5px" text-transform="uppercase" padding="4px 0 0" css-class="dm-muted">{{issueLabel}} &nbsp;·&nbsp; <a href="{{archiveUrl}}">View in browser</a></mj-text>
      </mj-column>
    </mj-section>

    {{heroBlock}}

    <mj-section padding="20px 16px 4px" css-class="dm-bg">
      <mj-column>
        <mj-text font-family="{{displayFont}}" font-size="20px" line-height="1.5" padding="0" css-class="dm-text">{{editorBlurb}}</mj-text>
      </mj-column>
    </mj-section>

    {{contentsBlock}}

    {{threatsSection}}
    {{threatBlocks}}

    {{promoBlock}}

    {{briefsSection}}

    {{postsSection}}
    {{postBlocks}}

    <mj-section padding="32px 16px 32px" css-class="dm-bg">
      <mj-column>
        <mj-divider border-color="{{borderColor}}" border-width="1px" padding="0 0 16px" css-class="dm-rule" />
        <mj-text font-size="12px" line-height="1.6" color="{{mutedColor}}" padding="0" css-class="dm-muted">
          {{legalName}}<br/>
          {{postalAddress}}<br/>
          {{advertisementNotice}}<br/><br/>
          You received this because you opted in to the Weekly Newsletter category.<br/>
          <a href="{{unsubscribeUrl}}">Unsubscribe</a> &nbsp;·&nbsp; <a href="{{preferenceUrl}}">Preferences</a> &nbsp;·&nbsp; <a href="{{archiveUrl}}">Archive</a><br/>
          {{ghlUnsubscribeMergeTag}}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
