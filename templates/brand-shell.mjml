<mjml>
  <mj-head>
    <mj-title>{{subject}}</mj-title>
    <mj-preview>{{preheader}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="{{textColor}}" font-size="16px" line-height="1.6" />
      <mj-button background-color="{{primaryColor}}" color="#FFFFFF" font-weight="bold" border-radius="4px" />
      <mj-section background-color="{{backgroundColor}}" />
    </mj-attributes>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
    </mj-raw>
    <mj-style>
      a { color: {{primaryColor}}; }
      /* Severity and deadline pills are the one place colour carries meaning
         rather than decoration, so they keep their own fill in dark mode and
         only the surrounding card flips. */
      .pill { border-radius: 3px; padding: 2px 7px; color: #ffffff; font-weight: bold; }
      /* Dark-mode support for clients that honour prefers-color-scheme
         (Apple Mail, many webmail/Android clients). Classic Outlook on
         Windows applies no dark transform at all and simply renders the
         light palette below as-is, which is the correct, safe fallback —
         see docs/plan for the research behind this choice. */
      @media (prefers-color-scheme: dark) {
        .dm-bg { background-color: #14181f !important; }
        .dm-card { background-color: #1c212b !important; }
        .dm-text { color: #eef1f5 !important; }
        .dm-muted { color: #9aa5b1 !important; }
        .dm-rule { border-color: #2c333f !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="{{backgroundColor}}" width="600px" css-class="dm-bg">
    <mj-section padding="24px 16px 4px" css-class="dm-bg">
      <mj-column>
        {{logoBlock}}
        <!-- The masthead carries identity, not the headline. The subject is
             capped at 60 characters for the inbox envelope, so setting it as
             an H1 printed a headline truncated mid-phrase — and the reader
             has already seen the subject in their inbox. The lead story is
             stated in full, once, in the 30-second read below. -->
        <mj-text font-size="11px" color="{{mutedColor}}" letter-spacing="1px" text-transform="uppercase" css-class="dm-muted">{{issueLabel}}</mj-text>
        <mj-text font-size="26px" font-weight="bold" line-height="1.25" padding-top="2px" css-class="dm-text">{{displayName}} Weekly</mj-text>
        <mj-text font-size="13px" padding-top="4px"><a href="{{archiveUrl}}">View in browser</a></mj-text>
      </mj-column>
    </mj-section>

    {{heroBlock}}

    <mj-section padding="4px 16px 8px" css-class="dm-bg">
      <mj-column border-left="3px solid {{primaryColor}}" padding-left="14px">
        <mj-text font-size="11px" color="{{mutedColor}}" letter-spacing="1px" text-transform="uppercase" css-class="dm-muted">The 30-second read</mj-text>
        <mj-text font-size="17px" line-height="1.55" padding-top="2px" css-class="dm-text">{{editorBlurb}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px 16px 0" css-class="dm-bg">
      <mj-column>
        <mj-divider border-color="{{borderColor}}" border-width="1px" padding-bottom="14px" css-class="dm-rule" />
        <mj-text font-size="20px" font-weight="bold" padding-bottom="2px" css-class="dm-text">Patch board — this week's KEV items</mj-text>
        <mj-text font-size="12px" line-height="1.5" color="{{mutedColor}}" css-class="dm-muted">Sorted ransomware-linked first, then nearest CISA remediation deadline. Public CISA KEV data is CC0 — this newsletter is not a CISA or DHS product and does not use agency marks.</mj-text>
      </mj-column>
    </mj-section>
    {{threatBlocks}}

    {{promoBlock}}

    {{briefsSection}}

    <mj-section padding="20px 16px 0" css-class="dm-bg">
      <mj-column>
        <mj-divider border-color="{{borderColor}}" border-width="1px" padding-bottom="14px" css-class="dm-rule" />
        <mj-text font-size="20px" font-weight="bold" css-class="dm-text">From the {{displayName}} blog</mj-text>
      </mj-column>
    </mj-section>
    {{postBlocks}}

    <mj-section padding="24px 16px 32px" css-class="dm-bg">
      <mj-column>
        <mj-divider border-color="{{borderColor}}" border-width="1px" css-class="dm-rule" />
        <mj-text font-size="12px" line-height="1.55" color="{{mutedColor}}" css-class="dm-muted">
          {{legalName}}<br/>
          {{postalAddress}}<br/>
          {{advertisementNotice}}<br/><br/>
          You received this because you opted in to the Weekly Newsletter category.<br/>
          <a href="{{unsubscribeUrl}}">Unsubscribe</a> · <a href="{{preferenceUrl}}">Preferences</a> · <a href="{{archiveUrl}}">Archive</a><br/>
          {{ghlUnsubscribeMergeTag}}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
