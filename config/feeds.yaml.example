# Feed allowlist. Live CMS URL is a TODO. CISA KEV URL is the public canonical feed.
schemaVersion: "1.0.0"

cms:
  originHost: "TODO.example.invalid" # TODO: S-02 / CMS host
  rssUrl: "https://TODO.example.invalid/feed" # TODO: published-posts RSS or REST

threatFeeds:
