    kind: kev-json
    url: "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"
    allowHost: "www.cisa.gov"
  - id: extra-rss
    kind: rss
    url: "https://TODO-threat-feed.example.invalid/rss" # TODO: extra allowlisted RSS or delete this row
    allowHost: "TODO-threat-feed.example.invalid"
